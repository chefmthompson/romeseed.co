/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' https://js.hsforms.net; connect-src 'self' https://*.hsforms.com https://*.hsforms.net; frame-src 'self' https://js.hsforms.net; form-action 'self' https://*.hsforms.com; frame-ancestors 'self'; base-uri 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/site.css
  Cache-Control: no-cache

/assets/fonts.css
  Cache-Control: no-cache

/assets/nav.js
  Cache-Control: no-cache

/ds/*
  Cache-Control: no-cache

/assets/*.png
  Cache-Control: public, max-age=604800
